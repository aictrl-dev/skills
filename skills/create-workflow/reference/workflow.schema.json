                  "required": [
                    "assignee"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "inputMapping": {
      "oneOf": [
        {
          "$ref": "../v1/workflow.schema.json#/$defs/inputMapping"
        },
        {
          "type": "object",
          "required": [
            "from",
            "afterWave"
          ],
          "additionalProperties": false,
          "properties": {
            "from": {
              "const": "gate"
            },
            "afterWave": {
              "type": "integer",
              "minimum": 1,
              "description": "The wave the manual quality gate follows (matches qualityGates[].afterWave)."
            },
            "gateIndex": {
              "type": "integer",
              "minimum": 0,
              "description": "The gate's position among qualityGates with the same afterWave; required only when that wave has more than one gate."
            }
          },
          "description": "Approval receipt of an upstream manual quality gate: decision, approver, channel, decidedAt, revision, note, approvedOutputs (a sha256 per covered output) and digest. Available only after the gate is approved; the consuming node must run in a later wave."
        }
      ]
    },
    "extract": {
      "$ref": "../v1/workflow.schema.json#/$defs/extract"
    },
    "edge": {
      "$ref": "../v1/workflow.schema.json#/$defs/edge"
    },
    "qualityGate": {
      "$ref": "../v1/workflow.schema.json#/$defs/qualityGate"
    },
    "retry": {
      "$ref": "../v1/workflow.schema.json#/$defs/retry"
    }
  }
}
